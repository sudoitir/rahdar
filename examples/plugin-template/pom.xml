<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A Rahdar plugin: one jar holding its descriptor, code, database changes and UI.
         Rename com.acme.notes / acme-notes throughout; `mvn verify` builds the jar and checks it
         exactly as Rahdar will when it is uploaded. -->
    <groupId>com.acme</groupId>
    <artifactId>acme-notes</artifactId>
    <version>1.0.0</version>

    <properties>
        <!-- Above the Spring Boot BOM's 11.0.24 (three critical CVEs), matching Rahdar. -->
        <tomcat.version>11.0.25</tomcat.version>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- @PreAuthorize("@perm.can(#clusterId, ...)") reads parameter names. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The oldest Rahdar this plugin supports. Its API jar is what the plugin compiles
             against, and it becomes plugin.json's rahdar.since, so Rahdar refuses the plugin
             on anything older. -->
        <rahdar.version>2026.10.5</rahdar.version>
        <rahdar.since>${rahdar.version}</rahdar.since>
        <!-- Rahdar's extension contract; a plugin built for another is refused. -->
        <rahdar.contract>18</rahdar.contract>
        <node.version>v24.21.0</node.version>
        <!-- Normally empty: the SDK comes from npm. Set to a packed SDK (.tgz) to build against a
             Rahdar that is not released yet, as Rahdar's own CI does. -->
        <rahdar.sdk></rahdar.sdk>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Rahdar runs a newer Tomcat than the BOM below names; declared first so it wins. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <!-- Rahdar's own dependency versions: the plugin runs on these. -->
            <!-- Above the Spring Boot BOM's Jackson 3.1.5 and 2.21.5 (five advisories, the last two
                 GHSA-cxp5-3px4-pw24 and GHSA-wv8q-qhhj-9h54), matching Rahdar; imported first so they win. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>3.1.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Rahdar itself: provided at runtime, never bundled. Only @PluginApi types are the
             supported API; anything else may change in any release. -->
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>rahdar</artifactId>
            <version>${rahdar.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- plugin.json gets its version, contract and rahdar.since from this pom. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/rahdar/plugin.json</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/rahdar/plugin.json</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- The UI: built by Vite with @rahdar/plugin-sdk's preset straight into
                 target/classes/META-INF/rahdar/ui, so it lands in the jar. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>web</workingDirectory>
                    <installDirectory>${project.build.directory}/node</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>install --no-audit --no-fund ${rahdar.sdk}</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>process-classes</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bundling a library? Rahdar refuses classes outside basePackage, so add
                 maven-shade-plugin with an artifactSet naming only that library and a relocation
                 under com.acme.notes.shaded — see README.md. This plugin bundles nothing. -->

            <!-- Checks the finished jar exactly as Rahdar will on upload, and fails the build
                 on anything Rahdar would refuse. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>verify-plugin</id>
                        <phase>verify</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>io.github.sudoitir.rahdar.kernel.plugin.PluginVerifier</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Signs the jar so Rahdar can tell who built it: active when -Dplugin.signing.keystore is
             set. Rahdar refuses an unsigned plugin unless an installer allows unverified ones.
             The store password comes from the environment, never from the command line or this
             file: export PLUGIN_SIGNING_STOREPASS. See README.md, "Sign your plugin". -->
        <profile>
            <id>sign</id>
            <activation>
                <property><name>plugin.signing.keystore</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jarsigner-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-plugin</id>
                                <phase>package</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <keystore>${plugin.signing.keystore}</keystore>
                                    <alias>${plugin.signing.alias}</alias>
                                    <storepass>${env.PLUGIN_SIGNING_STOREPASS}</storepass>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
