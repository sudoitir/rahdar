<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.sudoitir</groupId>
    <artifactId>rahdar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Rahdar</name>
    <description>Cluster-wide management and observability for Apache ActiveMQ Artemis</description>
    <url>https://github.com/sudoitir/rahdar</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- Required by Maven Central for the published plugin API (ADR-0102). -->
    <developers>
        <developer>
            <id>sudoitir</id>
            <name>Mahdi Amirabdollahi</name>
            <url>https://github.com/sudoitir</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/sudoitir/rahdar.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/sudoitir/rahdar.git</developerConnection>
        <url>https://github.com/sudoitir/rahdar</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <!-- Above Spring Boot 4.1.0's managed 11.0.24, which carries three critical CVEs
             (GHSA-9xv2-5v5q-p794, GHSA-gcx9-497g-6cp6, GHSA-h3x4-894j-xpx5). Drop once the
             Boot BOM manages 11.0.25 or later; OSV-Scanner in CI flags any regression. -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Above Spring Boot 4.1.1's managed Jackson 3.1.5 and 2.21.5, which carry three advisories
             (GHSA-gx83-3vf8-gh7j, GHSA-q4xh-88c3-wmh7, GHSA-wjgm-6hv5-3cvf). Drop once the Boot BOM
             manages 3.1.6 and 2.21.6 or later. -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The broker SDK and its Artemis driver (ADR-0203). Never a SNAPSHOT on main: CI refuses one. -->
        <openbroker.version>0.1.0</openbroker.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <spotless.version>3.10.4</spotless.version>
        <!-- Publishing the plugin API (ADR-0102); verified against Maven Central 2026-09-23. -->
        <central-publishing.version>0.12.0</central-publishing.version>
        <maven-gpg.version>3.2.8</maven-gpg.version>
        <maven-source.version>3.4.0</maven-source.version>
        <maven-javadoc.version>3.12.0</maven-javadoc.version>
        <json-schema-validator.version>3.0.8</json-schema-validator.version>
        <japicmp.version>0.26.5</japicmp.version>
        <palantir-java-format.version>2.97.0</palantir-java-format.version>

        <!-- Lombok version comes from the Spring Boot BOM. MapStruct and the
             Lombok↔MapStruct binding are not BOM-managed (ADR-0014). -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- OTel log appender: the instrumentation release built on the OpenTelemetry SDK that
             Spring Boot 4.1.1 manages (1.62.0), which the Boot BOM does not manage. Move it with
             that SDK version. datasource-micrometer 2.3.0 is built against Boot 4.1.1. -->
        <opentelemetry-logback-appender.version>2.28.1-alpha</opentelemetry-logback-appender.version>
        <datasource-micrometer.version>2.3.0</datasource-micrometer.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- springdoc 3.x is the Spring Boot 4 line (ADR-0019). -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- Installation-wide jobs run once across instances (ADR-0125). -->
        <shedlock.version>7.10.1</shedlock.version>
        <!-- MCP server (ADR-0045). 2.0.1, never 2.0.0: that release's STREAMABLE
             transport retained sessions without bound (CVE-2026-59279). -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- SPIKE (ADR-0047): latest train is 2025.1.3, built against Boot 4.0.8.
             There is no Boot 4.1 train yet. Kept only if the context actually starts. -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <!-- The WebAuthn test authenticator; the version spring-security-webauthn pulls in (ADR-0143). -->
        <webauthn4j.version>0.31.9.RELEASE</webauthn4j.version>
        <!-- SQL Console dialect parser (ADR-0058). Not BOM-managed. -->
        <jsqlparser.version>5.4</jsqlparser.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v24.21.0</node.version>

        <!-- The frontend build is opt-in so `mvn test` stays fast in day-to-day work.
             CI and the Docker image activate the `frontend` profile. -->
        <skip.frontend>true</skip.frontend>

        <!-- SonarQube Cloud analysis (ADR-0140), run by CI's `sonar` job. -->
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <sonar.organization>sudoitir</sonar.organization>
        <sonar.projectKey>sudoitir_rahdar</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.sources>src/main,web/src</sonar.sources>
        <sonar.tests>src/test,web/src</sonar.tests>
        <sonar.test.inclusions>src/test/**,web/src/**/*.test.ts,web/src/**/*.test.tsx,web/src/test/**</sonar.test.inclusions>
        <sonar.exclusions>web/src/test/**,web/src/kernel/api/schema.d.ts</sonar.exclusions>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.javascript.lcov.reportPaths>web/coverage/lcov.info</sonar.javascript.lcov.reportPaths>
        <!-- The changesets are PostgreSQL; the PL/SQL analyser is Oracle's and misreads them. -->
        <sonar.plsql.file.suffixes>.plsql</sonar.plsql.file.suffixes>
        <!-- The data grid is an ARIA grid of divs on CSS-grid tracks with one roving tab stop (ADR-0020,
             ADR-0108, ADR-0160); these three rules ask for native table elements and a tab stop on every
             row, grid and cell. Only GridTable.tsx, only these rules. -->
        <sonar.issue.ignore.multicriteria>grid1,grid2,grid3</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.grid1.ruleKey>typescript:S6819</sonar.issue.ignore.multicriteria.grid1.ruleKey>
        <sonar.issue.ignore.multicriteria.grid1.resourceKey>web/src/ui/table/GridTable.tsx</sonar.issue.ignore.multicriteria.grid1.resourceKey>
        <sonar.issue.ignore.multicriteria.grid2.ruleKey>typescript:S6852</sonar.issue.ignore.multicriteria.grid2.ruleKey>
        <sonar.issue.ignore.multicriteria.grid2.resourceKey>web/src/ui/table/GridTable.tsx</sonar.issue.ignore.multicriteria.grid2.resourceKey>
        <sonar.issue.ignore.multicriteria.grid3.ruleKey>typescript:S1082</sonar.issue.ignore.multicriteria.grid3.ruleKey>
        <sonar.issue.ignore.multicriteria.grid3.resourceKey>web/src/ui/table/GridTable.tsx</sonar.issue.ignore.multicriteria.grid3.resourceKey>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4.x no longer manages the Testcontainers versions itself. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Module boundaries verified at build time (ADR-0069). -->
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- MVC + Tomcat + SseEmitter for SSE (ADR-0003, Phase 2).
                 No WebFlux — nothing needs reactive. -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <!-- Blocking RestClient for Jolokia (ADR-0010). Boot 4 splits this
                 out of starter-web; it brings HttpClientSettings +
                 ClientHttpRequestFactoryBuilder and the RestClient.Builder bean. -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <!-- CSV writer for the audit export, which streams rows without building the file in memory. -->
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-csv</artifactId>
        </dependency>
        <dependency>
            <!-- SMTP for email notification channels (ADR-0099). Rahdar builds one sender per
                 channel; the auto-configured global JavaMailSender is unused and backs off
                 without spring.mail.host. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <!-- @ApplicationModule / @NamedInterface declarations only; no runtime (ADR-0069). -->
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!-- Passkeys for local accounts (ADR-0143): WebAuthnRelyingPartyOperations and its JDBC
                 repositories, called from our own JSON endpoints. Brings webauthn4j-core. -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-webauthn</artifactId>
        </dependency>
        <!-- OIDC login (Phase 8, ADR-0040). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Session store for cookie-based auth (Phase 8, ADR-0037); schema owned
             by our own Liquibase changeset (014-identity.sql), never the
             library's auto-initializer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <!-- HashiCorp Vault key provider (KV v2); the version comes from the Spring Cloud BOM. -->
            <groupId>org.springframework.vault</groupId>
            <artifactId>spring-vault-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- MCP server over the existing MVC stack, stateless (ADR-0045). Version
             from the spring-ai BOM imported above. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Boilerplate + mapping (ADR-0014). Lombok is compile-only; MapStruct's
             runtime is tiny (annotations + a helper). Processors are wired in the
             compiler plugin below. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Schema migrations: Liquibase, XML master changelog + SQL changesets.
             Boot 4 splits auto-configuration per module; this starter brings
             liquibase-core and the spring-boot-liquibase auto-configuration.
             Version (5.0.3) is managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <!-- Takes Liquibase's migration lock as a PostgreSQL session advisory lock, so a replica that
             dies mid-migration releases it with its connection (ADR-0192). -->
        <dependency>
            <groupId>com.github.blagerweij</groupId>
            <artifactId>liquibase-sessionlock</artifactId>
            <version>1.6.9</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Every broker is reached through the broker SDK (ADR-0203). The Artemis driver brings the
             Artemis client; no Rahdar code may use it (BoundaryRulesTest), and the tests drive the
             broker with it. -->
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-api</artifactId>
            <version>${openbroker.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-support</artifactId>
            <version>${openbroker.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-artemis</artifactId>
            <version>${openbroker.version}</version>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OTLP export of metrics, traces and logs, off unless the OTEL_* variables switch it on (ADR-0147).
             The starter brings the Micrometer Tracing OTel bridge, the OTLP span exporter and the
             OTLP meter registry; JDBC spans come from datasource-micrometer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry-logback-appender.version}</version>
        </dependency>
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
            <version>${datasource-micrometer.version}</version>
        </dependency>

        <!-- Phase 5: the correlator's hot in-flight-flow lookup cache, in front
             of rr_flow (design.md D5). Version managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- The SQL Console's dialect parser (ADR-0058). Rahdar parses to an AST
             and validates every node against a whitelist; JSqlParser supplies the
             tree, never the authorization. -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>${jsqlparser.version}</version>
        </dependency>

        <!-- OpenAPI 3 document at /v3/api-docs (+ Swagger UI). The frontend's
             web/src/kernel/api/schema.d.ts is generated from a committed snapshot of
             this document (ADR-0019, primary path taken in Phase 3). The 3.x
             line is built against Spring Boot 4.1.0. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- ApplicationModules.verify(), @ApplicationModuleTest, module canvases (ADR-0069). -->
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- A software authenticator, so the passkey tests register and sign in for real. -->
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-test</artifactId>
            <version>${webauthn4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Contract tests validate every API response against web/openapi.json with it (JSON Schema
                 2020-12, so unevaluatedProperties can reject an undocumented field). Not test scoped: the
                 MCP server reads it at runtime too, and a test-scoped declaration here would leave it out
                 of the jar and stop Rahdar starting. -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-vault</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rahdar</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- The runnable jar is target/rahdar-exec.jar (the image, the release
                         asset). The plain jar keeps the main artifact's name: it is the plugin API
                         plugins compile against, published to Maven Central (ADR-0102). -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <!-- Bakes the running version into META-INF/build-info.properties, read
                         by RahdarVersion (kernel.plugin) for the plugin compatibility range. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Annotation processors, in order (ADR-0014): Lombok, then the
                 Lombok↔MapStruct binding, then the MapStruct processor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Palantir Java Format via Spotless, applied at compile time:
                 `spotless:apply` is bound to process-sources, so every `mvn compile`
                 (and the IDE's build) reformats sources first. `mvn spotless:check`
                 runs in `verify` and fails CI on drift.
                 Needs the JDK compiler exports in .mvn/jvm.config. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-apply</id>
                        <phase>process-sources</phase>
                        <goals><goal>apply</goal></goals>
                    </execution>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Liquibase CLI for schema authoring and ops. Runtime migration is
                 done by Spring Boot on startup; this plugin is for humans:
                   mvn liquibase:updateSQL      preview the SQL a changeset emits
                   mvn liquibase:status         what is pending
                   mvn liquibase:rollback -Dliquibase.rollbackCount=1
                   mvn liquibase:diff           drift between changelog and a live DB
                 Reads db connection from liquibase.properties (git-ignored values
                 via env). Version managed by the Boot BOM (5.0.3). -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <configuration>
                    <propertyFile>liquibase.properties</propertyFile>
                    <searchPath>${project.basedir},${project.basedir}/src/main/resources</searchPath>
                    <changeLogFile>db/changelog/db.changelog-master.xml</changeLogFile>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Test coverage (ADR-0128): the agent records every test run into target/jacoco.exec,
                 and verify writes the HTML, XML and CSV report to target/site/jacoco. CI merges
                 the shards' exec files into one report. Informational: no threshold fails a build. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `-Prelease`: the plugin API to Maven Central (ADR-0102). Sources, javadoc and GPG
             signatures are what Central requires; the Central plugin uploads and publishes. The
             passphrase comes from MAVEN_GPG_PASSPHRASE and the token from settings.xml server
             `central` (CI writes both from secrets). Run with -Dspring-boot.repackage.skip=true:
             Central gets the plain jar, its sources and javadoc, never the runnable exec jar. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg.version}</version>
                        <configuration>
                            <!-- Reads MAVEN_GPG_PASSPHRASE; never a passphrase on the command line. -->
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `-Papi-check`: the plugin API may not break within a contract version (ADR-0102).
             Compares every @PluginApi type with the latest release on Maven Central; with no
             release yet there is nothing to compare, and it passes. A deliberate break bumps
             Contract.VERSION, and the release job then passes -Djapicmp.skip=true (ADR-0112). -->
        <profile>
            <id>api-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>RELEASE</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                            <parameter>
                                <includes>
                                    <include>@io.github.sudoitir.rahdar.kernel.plugin.PluginApi</include>
                                </includes>
                                <onlyModified>true</onlyModified>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <skipPomModules>false</skipPomModules>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>cmp</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Activate with `-Pfrontend` (CI, Docker). Builds web/ with a managed Node,
             then copies web/dist into the jar's static resources. -->
        <profile>
            <id>frontend</id>
            <properties>
                <skip.frontend>false</skip.frontend>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>web</workingDirectory>
                            <installDirectory>${project.build.directory}/node</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>ci</arguments></configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <goals><goal>npm</goal></goals>
                                <phase>prepare-package</phase>
                                <configuration><arguments>run build</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>web/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
